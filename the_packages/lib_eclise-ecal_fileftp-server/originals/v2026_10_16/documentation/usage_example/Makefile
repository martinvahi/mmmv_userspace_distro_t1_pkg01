#==========================================================================
default: all
#--------------------------------------------------------------------------
clean:
	@printf "Task \"clean\" .. "
	@rm -f ./ftpserver
	@printf "\e[32m🗸\e[39m\n"

c: clean # for convenience only
#--------------------------------------------------------------------------
# The
REQUIRED_COMMAND_LINE_PROGRAMS:=g++ sync
# lists more than this Makefile requires in practice, so please delete
# items from that list according to how this Makefile is used.

# The next line has been mostly generated by the ChatGPT bot.
assert_command_line_programs_availabiliyt:
	@missing="" ; \
	for t in $(REQUIRED_COMMAND_LINE_PROGRAMS); do \
	    command -v $$t >/dev/null 2>&1 || missing="$$missing $$t" ; \
	done ; \
	if [ -n "$$missing" ]; then \
	    echo    "" ; \
	    echo -e "The\e[31m $$missing is missing from PATH\e[39m." ; \
	    echo    "GUID=='98792852-e685-4a39-9553-73b27031aae7'" ; \
	    echo    "" ; \
	    exit 1 ; \
	fi ;
#--------------------------------------------------------------------------
build: assert_command_line_programs_availabiliyt clean
	@sync ; wait
	g++ -o ftpserver main.cpp -I./../include -L./../lib -lfineftp-server
	@sync ; wait
	@printf "Task \"build\" \e[32mcomplete\e[39m.\n"

b: build # for convenience only
#--------------------------------------------------------------------------
help:
	@printf "\nThe set of targets/tasks of this GNU Makefile include:\n"
	@printf "    \e[33mbuild\e[39m, \e[33mclean\e[39m, \e[33mall\e[39m.\n\n"

h: help # mostly for convenience
#--------------------------------------------------------------------------
all: build
	@printf "\nMaybe it all worked :-) \n\n"
#	@printf "\n\e[32m Maybe it all worked\e[39m :-) \n\n"

a: all # for convenience only
